#!/bin/bash
#
# List plain addresses in restrictions/* .  Process those here into hook
# statements.

# LIMITATIONS
#
# Some decisions based on settings are only made the FIRST time the Compose
# interface is shown.  If you hit 'e' to edit a message again, and you add
# recipients, send2-hook will react, but the changed setting may have no
# effect.
#
# For example, crypt_autosign affects the decision of whether to automatically
# sign a message.  That decision is only made the FIRST time the Compose
# interface is shown.  If you press 'e' to edit, add a recipient listed in
# no_crypt_autosign, then save and quit the editor, your message will still be
# signed.  Hit 'p' for PGP options to rectify the situation yourself.



function main() {
  restrictions=~/.mutt.d/restrictions

  # If an option is handled here, any occurrence in static configuration should
  # be commented out and augmented with comments referring to this script.

  # restrict_option     option                          default

  # PGP signing to listed recipients will not just fail but will break
  # communication entirely.
  restrict_option       'crypt_autosign'                'set'

  # I may have public keys for listed recipients, but they do not use their
  # keys for encrypted mail, so encrypting messages will break communication.
  restrict_option       'crypt_opportunistic_encrypt'   'set'
}


function build_target() {
  # Restriction lists are assumed to consist of plain complete email addresses.
  printf '%s' "^${1}\$" | sed 's#\.#\\.#g'
}


function restrict_option() {
  option="${1}"
  default="${2}"

  # Always set a default hook matching ".", or the effect of the most recent
  # hook will linger.  Scope is not limited to the current message.

  # Use send2-hook, not send-hook.  send-hook fires BEFORE editing.  send2-hook
  # fires AFTER editing.

  printf "%s\n" "send2-hook . '${default} ${option}'"

  yes_list_plain="${restrictions}/plain/yes_${option}"
  no_list_plain="${restrictions}/plain/no_${option}"
  yes_list_regex="${restrictions}/regex/yes_${option}"
  no_list_regex="${restrictions}/regex/no_${option}"


  # <(grep -vE '^#|^$' "${file}")
  # Enable option for recipients on the yes list, if any.
  if test -e "${yes_list_plain}"; then
    while read address; do
      target="$(build_target "${address}")"
      printf "%s\n" "send2-hook '~C ${target}' 'set ${option}'"
    done < <(grep -vE '^#|^$' "${yes_list_plain}")
  fi
  if test -e "${yes_list_regex}"; then
    while read regex; do
      printf "%s\n" "send2-hook '${regex}' 'set ${option}'"
    done < <(grep -vE '^#|^$' "${yes_list_regex}")
  fi

  # Disable option for recipients on the no list, if any.
  if test -e "${no_list_plain}"; then
    while read address; do
      target="$(build_target "${address}")"
      printf "%s\n" "send2-hook '~C ${target}' 'unset ${option}'"
    done < <(grep -vE '^#|^$' "${no_list_plain}")
  fi
  if test -e "${no_list_regex}"; then
    while read regex; do
      printf "%s\n" "send2-hook '${regex}' 'unset ${option}'"
    done < <(grep -vE '^#|^$' "${no_list_regex}")
  fi
}


main "${@}"
